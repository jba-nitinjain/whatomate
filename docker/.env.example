# Server timezone (used for IVR timing node business hours)
TZ=UTC

# PostgreSQL
POSTGRES_USER=whatomate
POSTGRES_PASSWORD=whatomate
POSTGRES_DB=whatomate

# Optional overrides for any config.toml key: WHATOMATE_<SECTION>__<KEY>
# (double underscore between levels). Legacy single-underscore names such as
# WHATOMATE_DATABASE_HOST still work but are deprecated.
# WHATOMATE_APP__ENVIRONMENT=production
# WHATOMATE_JWT__SECRET=change-me
